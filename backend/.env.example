# Django Core Settings
SECRET_KEY=replace-with-a-very-long-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_NAME=fraudshield
DB_USER=fraudshield_user
DB_PASSWORD=fraudshield_pass
DB_HOST=localhost
DB_PORT=5432

# CORS (Frontend domains allowed to communicate with the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Production Settings (if DJANGO_SETTINGS_MODULE=config.settings.production)
SECURE_SSL_REDIRECT=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
