# Django Core Settings
SECRET_KEY=replace-with-a-very-long-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.vercel.app

# Database Configuration (Local PostgreSQL)
DB_NAME=fraudshield
DB_USER=fraudshield_user
DB_PASSWORD=fraudshield_pass
DB_HOST=localhost
DB_PORT=5432

# Production Database (Neon Serverless PostgreSQL with Connection Pooling)
# Obtain pooled connection string from Neon Console (with -pooler host):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-late-tree-11384276-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
CONN_MAX_AGE=0

# CORS (Frontend domains allowed to communicate with the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Real-Time Notification & Email Settings
DEFAULT_FROM_EMAIL=alerts@fraudshield.internal
DEFAULT_ANALYST_EMAIL=analyst@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production Security
SECURE_SSL_REDIRECT=False
